---
import BaseLayout from "../../layouts/BaseLayout.astro";
const { slug } = Astro.params;
---
---
export async function getStaticPaths() {
  return [
    {
      params: { slug: "demo-product" },
      props: {
        title: "Demo Product",
        description: "This is a demo product page",
        header: "product"
      }
    }
  ];
}

const { title, description } = Astro.props;
---
<BaseLayout title={slug} headerVariant="product">
  <h1>Product: {slug}</h1>
  <p>Content comes from CMS.</p>
</BaseLayout>
